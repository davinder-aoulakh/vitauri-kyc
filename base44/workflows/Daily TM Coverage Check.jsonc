{
  "name": "Daily TM Coverage Check",
  "description": "Runs daily at 02:00 UTC: builds CoverageDay rows per bank account, flags stalled bank connections and expiring PSD2 consents, and notifies each tenant's Compliance Officers and Tenant Admins.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_tm_coverage_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "coverageJob",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}