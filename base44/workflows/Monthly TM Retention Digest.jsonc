{
  "name": "Monthly TM Retention Digest",
  "description": "1st of each month at 01:00 UTC: counts transaction monitoring records past each tenant's retention period and notifies Compliance Admins. Never deletes anything.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_tm_retention_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tmRetentionDigest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}