{
  "name": "Nightly Didit Rule Drift",
  "description": "Runs daily at 04:00 UTC: compares every synced TM rule with its Didit version, flags differences as drift and notifies the rule owner. Never overwrites changes made in the Didit console.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_didit_rule_drift",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDiditRule",
            "args": {
              "mode": "drift"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}