{
  "name": "Hourly TM Deadline Sweep",
  "description": "Runs hourly at minute 5: recomputes deadline clocks for open TM alerts and cases and notifies assignees of items due within 24 h or expired.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_tm_deadline_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deadlineSweep",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}