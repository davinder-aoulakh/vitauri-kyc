{
  "name": "FiuReport",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "report_ref": {
      "type": "string",
      "description": "e.g. UTR-CW-0931"
    },
    "fiu_profile_code": {
      "type": "string",
      "enum": [
        "CW",
        "NL"
      ]
    },
    "tm_case_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "alert_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "unusual_objective",
        "unusual_subjective"
      ]
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "generated",
        "submitted",
        "received",
        "accepted",
        "rejected"
      ],
      "default": "draft"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "enum": [
              "agent",
              "user",
              "system"
            ]
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrative": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "executed_at": {
          "type": "string"
        },
        "received_at": {
          "type": "string"
        },
        "discovered_at": {
          "type": "string"
        },
        "escalated_at": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "due_at": {
          "type": "string"
        }
      }
    },
    "prepared_by_user_id": {
      "type": "string"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "didit_report_id": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "file_url": {
          "type": "string"
        },
        "file_hash": {
          "type": "string"
        },
        "pdf_url": {
          "type": "string"
        }
      }
    },
    "submitted": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "by_user_id": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string"
        }
      }
    },
    "received": {
      "type": "object",
      "properties": {
        "fiu_reference": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "snapshot": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "report_ref",
    "fiu_profile_code"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}