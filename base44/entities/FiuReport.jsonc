{
  "name": "FiuReport",
  "properties": {
    "alert_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "approval": {
      "description": "Checks and decision recorded at approval",
      "type": "object"
    },
    "approved_at": {
      "format": "date-time",
      "type": "string"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "clock": {
      "properties": {
        "decided_at": {
          "type": "string"
        },
        "discovered_at": {
          "type": "string"
        },
        "due_at": {
          "type": "string"
        },
        "escalated_at": {
          "type": "string"
        },
        "executed_at": {
          "type": "string"
        },
        "intended_at": {
          "type": "string"
        },
        "received_at": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "decision_id": {
      "type": "string"
    },
    "didit_report_id": {
      "type": "string"
    },
    "didit_template_code": {
      "type": "string"
    },
    "fields": {
      "items": {
        "properties": {
          "by": {
            "enum": [
              "agent",
              "user",
              "system"
            ],
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "filed_document_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "fiu_profile_code": {
      "enum": [
        "CW",
        "NL"
      ],
      "type": "string"
    },
    "generated": {
      "properties": {
        "at": {
          "type": "string"
        },
        "file_hash": {
          "type": "string"
        },
        "file_url": {
          "type": "string"
        },
        "pdf_url": {
          "type": "string"
        },
        "source": {
          "description": "manual_upload when the XML was generated in the Didit console and uploaded",
          "type": "string"
        }
      },
      "type": "object"
    },
    "generation_error": {
      "type": "string"
    },
    "generation_error_at": {
      "format": "date-time",
      "type": "string"
    },
    "generation_path_missing": {
      "default": false,
      "description": "Last goAML generation failed because a Didit endpoint answered 404/405",
      "type": "boolean"
    },
    "indicators": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "kyc_case_id": {
      "type": "string"
    },
    "lateness_reason": {
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "narrative": {
      "properties": {
        "citations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "prepared_by_user_id": {
      "type": "string"
    },
    "received": {
      "properties": {
        "at": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string"
        },
        "fiu_reference": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "rejection_reason": {
      "type": "string"
    },
    "report_ref": {
      "description": "e.g. UTR-CW-0931",
      "type": "string"
    },
    "snapshot": {
      "type": "object"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "generated",
        "submitted",
        "received",
        "accepted",
        "rejected"
      ],
      "type": "string"
    },
    "submitted": {
      "properties": {
        "at": {
          "type": "string"
        },
        "by_user_id": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "submitted_for_approval_at": {
      "format": "date-time",
      "type": "string"
    },
    "submitted_for_approval_by": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tm_case_id": {
      "type": "string"
    },
    "transactions_mapped": {
      "type": "number"
    },
    "type": {
      "enum": [
        "unusual_objective",
        "unusual_subjective"
      ],
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number"
    }
  },
  "required": [
    "tenant_id",
    "report_ref",
    "fiu_profile_code"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}