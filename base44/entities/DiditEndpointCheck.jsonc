{
  "name": "DiditEndpointCheck",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant the probe ran against"
    },
    "kind": {
      "type": "string",
      "enum": [
        "endpoints",
        "credentials"
      ],
      "description": "Missing = endpoints (legacy records). 'credentials' = credential self-test."
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_by_user_id": {
      "type": "string"
    },
    "credentials": {
      "type": "object",
      "description": "kind=credentials only. Sources and probe outcome. Never holds key material.",
      "properties": {
        "tenant_name": {
          "type": "string"
        },
        "api_key_source": {
          "type": "string",
          "enum": [
            "TenantSecret",
            "Tenant (legacy)",
            "missing"
          ]
        },
        "webhook_secret_source": {
          "type": "string",
          "enum": [
            "TenantSecret",
            "Tenant (legacy)",
            "missing"
          ]
        },
        "probe": {
          "type": "string",
          "enum": [
            "ok",
            "auth_error",
            "unreachable"
          ]
        },
        "http_status": {
          "type": "number"
        },
        "path": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "classification": {
            "type": "string",
            "enum": [
              "ok",
              "reachable",
              "missing",
              "auth",
              "error",
              "skipped"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "tenant_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "data.app_role": "Vitauri Ops"
      }
    },
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false
  }
}