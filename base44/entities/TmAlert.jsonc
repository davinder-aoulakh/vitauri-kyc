{
  "name": "TmAlert",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "transaction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenario_id": {
      "type": "string"
    },
    "didit_transaction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "priority": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "triaged",
        "in_review",
        "closed_false_positive",
        "closed_no_action",
        "escalated",
        "reported"
      ],
      "default": "new"
    },
    "indicator_type": {
      "type": "string",
      "enum": [
        "objective",
        "subjective"
      ]
    },
    "ai_proposal": {
      "type": "string",
      "enum": [
        "escalate",
        "close",
        "request_info",
        "insufficient_evidence"
      ]
    },
    "ai_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_run_id": {
      "type": "string"
    },
    "assigned_to_user_id": {
      "type": "string"
    },
    "tm_case_id": {
      "type": "string"
    },
    "close_reason": {
      "type": "string"
    },
    "closed_by_user_id": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "dedupe_key": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "didit_rule",
        "profile_deviation",
        "manual",
        "quality_sample"
      ],
      "default": "didit_rule"
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}