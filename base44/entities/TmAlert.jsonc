{
  "name": "TmAlert",
  "properties": {
    "ai_insufficient_evidence": {
      "default": false,
      "type": "boolean"
    },
    "ai_missing": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ai_proposal": {
      "enum": [
        "escalate",
        "close",
        "request_info",
        "insufficient_evidence"
      ],
      "type": "string"
    },
    "ai_reason_refs": {
      "description": "AI triage reasons with their cited sources",
      "items": {
        "properties": {
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "ai_reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ai_run_id": {
      "type": "string"
    },
    "assigned_to_user_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "close_reason": {
      "type": "string"
    },
    "closed_by_user_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "didit_transaction_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "discovered_at": {
      "format": "date-time",
      "type": "string"
    },
    "due_at": {
      "format": "date-time",
      "type": "string"
    },
    "executed_at": {
      "format": "date-time",
      "type": "string"
    },
    "expired_on_arrival": {
      "default": false,
      "type": "boolean"
    },
    "indicator_type": {
      "enum": [
        "objective",
        "subjective"
      ],
      "type": "string"
    },
    "intended_at": {
      "description": "Intended (payment instruction) time, when known \u2014 first moment of the deadline clock",
      "format": "date-time",
      "type": "string"
    },
    "phase": {
      "description": "Deadline clock phase: escalate | investigate | report",
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "received_at": {
      "format": "date-time",
      "type": "string"
    },
    "ref": {
      "description": "Human-readable reference AL-<year>-<seq>, per tenant",
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scenario_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "source": {
      "default": "didit_rule",
      "enum": [
        "didit_rule",
        "profile_deviation",
        "manual",
        "quality_sample"
      ],
      "type": "string"
    },
    "status": {
      "default": "new",
      "enum": [
        "new",
        "triaged",
        "in_review",
        "closed_false_positive",
        "closed_no_action",
        "escalated",
        "reported"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tm_case_id": {
      "type": "string"
    },
    "transaction_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}