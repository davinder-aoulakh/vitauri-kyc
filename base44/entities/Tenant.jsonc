{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Institution name e.g. Acme Bank NV"
    },
    "slug": {
      "type": "string",
      "description": "URL slug, unique"
    },
    "branding_logo_url": {
      "type": "string",
      "description": "Logo URL"
    },
    "branding_primary_color": {
      "type": "string",
      "description": "Hex color e.g. #1A6BFF",
      "default": "#1A6BFF"
    },
    "default_language": {
      "type": "string",
      "enum": [
        "en",
        "nl"
      ],
      "default": "en"
    },
    "audit_retention_years": {
      "type": "number",
      "default": 5
    },
    "risk_scoring_model": {
      "type": "string",
      "enum": [
        "highest_risk",
        "points_based"
      ],
      "default": "highest_risk"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Suspended",
        "Demo"
      ],
      "default": "Active"
    },
    "edr_due_days": {
      "type": "number",
      "default": 30
    },
    "branding_secondary_color": {
      "type": "string",
      "default": "#E8F0FF",
      "description": "Secondary brand color"
    },
    "branding_bg_color": {
      "type": "string",
      "default": "#F4F6FA",
      "description": "Portal background color"
    },
    "branding_text_color": {
      "type": "string",
      "default": "#1A2332",
      "description": "Primary text color"
    },
    "branding_font_family": {
      "type": "string",
      "default": "Inter",
      "enum": [
        "Inter",
        "DM Sans",
        "Georgia",
        "Roboto",
        "Open Sans"
      ],
      "description": "Portal font family"
    },
    "branding_button_radius": {
      "type": "string",
      "default": "rounded",
      "enum": [
        "square",
        "rounded",
        "pill"
      ],
      "description": "Button border radius style"
    },
    "branding_favicon_url": {
      "type": "string",
      "description": "Favicon URL"
    },
    "branding_header_style": {
      "type": "string",
      "default": "dark",
      "enum": [
        "dark",
        "light"
      ],
      "description": "Portal header style"
    },
    "white_label_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Hide Vitauri branding from portal"
    },
    "email_from_name": {
      "type": "string",
      "description": "From name e.g. Compliance Team \u2014 Meridian Trust"
    },
    "email_from_address": {
      "type": "string",
      "description": "From address e.g. compliance@meridiantrust.nl"
    },
    "email_reply_to": {
      "type": "string",
      "description": "Optional reply-to email address"
    },
    "portal_welcome_title": {
      "type": "string",
      "description": "Portal welcome heading"
    },
    "portal_welcome_body": {
      "type": "string",
      "description": "Portal welcome body (rich text)"
    },
    "portal_footer_text": {
      "type": "string",
      "description": "Portal footer (rich text)"
    },
    "portal_contact_info": {
      "type": "string",
      "description": "Contact info shown on portal"
    },
    "portal_subdomain": {
      "type": "string",
      "description": "Portal subdomain (lowercase, no spaces)"
    },
    "didit_api_key": {
      "type": "string",
      "description": "Didit x-api-key \u2014 entered by Tenant Admin, keep secret"
    },
    "didit_workflow_id": {
      "type": "string",
      "description": "UUID of the default Didit KYC workflow"
    },
    "didit_workflows": {
      "type": "string",
      "description": "JSON array of Didit workflow configurations."
    },
    "didit_min_match_score": {
      "type": "number",
      "default": 80,
      "description": "Face match % threshold"
    },
    "didit_app_id": {
      "type": "string",
      "description": "Optional \u2014 Didit Application UUID for console deep-links"
    },
    "didit_webhook_secret": {
      "type": "string",
      "description": "Shared secret used to verify the X-Signature-V2 HMAC on incoming Didit webhooks \u2014 returned by Didit when a webhook destination is registered"
    },
    "pending_admin_email": {
      "type": "string",
      "description": "Email of the invited Tenant Admin \u2014 cleared after onboarding is complete"
    },
    "onboarding_token": {
      "type": "string",
      "description": "Secure random token for the admin onboarding link \u2014 single-use, cleared after use"
    },
    "onboarding_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry timestamp for the onboarding token (72 hours from creation)"
    },
    "features_enabled": {
      "type": "string",
      "description": "JSON object of feature flag overrides per tenant. Missing key = feature ON. e.g. {\"outreach\": false, \"batch_screening\": false}"
    },
    "sign_off_matrix": {
      "type": "object",
      "description": "Sign-off requirements per risk class. Keys: Low, Medium, High, Unacceptable. Each value: { approver: string, compliance_mandatory: boolean }"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}