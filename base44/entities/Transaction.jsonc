{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client \u2014 sent to Didit as subject.vendor_data"
    },
    "case_id": {
      "type": "string",
      "description": "nullable \u2014 FK to KycCase if linked"
    },
    "our_transaction_id": {
      "type": "string",
      "description": "Our unique ID (<=128 chars) sent to Didit as transaction_id"
    },
    "didit_transaction_id": {
      "type": "string",
      "description": "Didit's returned transaction ID"
    },
    "transaction_category": {
      "type": "string",
      "enum": [
        "finance",
        "kyc",
        "travel_rule",
        "user_event",
        "audit_trail_event",
        "gambling_bet",
        "gambling_limit_change",
        "gambling_bonus_change"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 for fiat, chain:ticker for crypto (e.g. bitcoin:BTC)"
    },
    "currency_kind": {
      "type": "string",
      "enum": [
        "fiat",
        "crypto"
      ]
    },
    "counterparty_name": {
      "type": "string"
    },
    "counterparty_account_id": {
      "type": "string",
      "description": "IBAN / account number / wallet address"
    },
    "counterparty_method_type": {
      "type": "string",
      "enum": [
        "bank_card",
        "bank_account",
        "crypto_wallet",
        "unhosted_wallet",
        "ewallet",
        "other"
      ]
    },
    "subject_entity_type": {
      "type": "string",
      "enum": [
        "person",
        "company"
      ],
      "default": "person"
    },
    "subject_full_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "IN_REVIEW",
        "DECLINED",
        "AWAITING_USER"
      ],
      "default": "PENDING"
    },
    "risk_score": {
      "type": "number",
      "description": "nullable"
    },
    "risk_level": {
      "type": "string",
      "description": "nullable"
    },
    "decision_raw": {
      "type": "object",
      "description": "Full Didit response for audit"
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "reviewed_by_user_id": {
      "type": "string",
      "description": "nullable"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "nullable"
    },
    "review_decision": {
      "type": "string",
      "enum": [
        "Approved",
        "Blocked",
        "Escalated"
      ],
      "description": "nullable"
    },
    "review_notes": {
      "type": "string",
      "description": "nullable"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "intended",
        "declined",
        "booked",
        "reversed",
        "corrected"
      ],
      "default": "booked"
    },
    "related_to": {
      "type": "string",
      "description": "Transaction id of the original booking for a reversal/correction"
    },
    "intended_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "api",
        "psd2",
        "upload_csv",
        "upload_xlsx",
        "upload_mt940",
        "upload_camt",
        "upload_pdf"
      ],
      "default": "manual"
    },
    "source_file_id": {
      "type": "string",
      "description": "StatementUpload id"
    },
    "ingest_batch_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "coverage_date": {
      "type": "string",
      "format": "date"
    },
    "bank_account_id": {
      "type": "string"
    },
    "own_transfer": {
      "type": "boolean",
      "default": false
    },
    "fx": {
      "type": "object",
      "properties": {
        "rate": {
          "type": "number"
        },
        "rate_date": {
          "type": "string"
        },
        "reporting_currency": {
          "type": "string"
        },
        "amount_reporting": {
          "type": "number"
        }
      }
    },
    "description_raw": {
      "type": "string"
    },
    "counterparty_id": {
      "type": "string"
    },
    "counterparty_country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2"
    },
    "counterparty_match_confidence": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "category_confidence": {
      "type": "number"
    },
    "didit_last_event_id": {
      "type": "string"
    },
    "didit_rule_runs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "didit_submission_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "failed"
      ],
      "default": "not_submitted"
    },
    "didit_submission_error": {
      "type": "string"
    },
    "historical": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ]
}