{
  "name": "Transaction",
  "properties": {
    "amount": {
      "type": "number"
    },
    "bank_account_id": {
      "type": "string"
    },
    "blocked": {
      "default": false,
      "description": "Didit DECLINED: blocked in Vitauri (the core system holds/stops the payment)",
      "type": "boolean"
    },
    "blocked_at": {
      "format": "date-time",
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    },
    "case_id": {
      "description": "nullable \u2014 FK to KycCase if linked",
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_confidence": {
      "type": "number"
    },
    "client_id": {
      "description": "FK to Client \u2014 sent to Didit as subject.vendor_data",
      "type": "string"
    },
    "counterparty_account_id": {
      "description": "IBAN / account number / wallet address",
      "type": "string"
    },
    "counterparty_country": {
      "description": "ISO 3166-1 alpha-2",
      "type": "string"
    },
    "counterparty_id": {
      "type": "string"
    },
    "counterparty_match_confidence": {
      "type": "number"
    },
    "counterparty_method_type": {
      "enum": [
        "bank_card",
        "bank_account",
        "crypto_wallet",
        "unhosted_wallet",
        "ewallet",
        "other"
      ],
      "type": "string"
    },
    "counterparty_name": {
      "type": "string"
    },
    "coverage_date": {
      "format": "date",
      "type": "string"
    },
    "currency": {
      "description": "ISO 4217 for fiat, chain:ticker for crypto (e.g. bitcoin:BTC)",
      "type": "string"
    },
    "currency_kind": {
      "enum": [
        "fiat",
        "crypto"
      ],
      "type": "string"
    },
    "decision_raw": {
      "description": "Full Didit response for audit",
      "type": "object"
    },
    "dedupe_key": {
      "type": "string"
    },
    "description_raw": {
      "type": "string"
    },
    "didit_last_event_id": {
      "type": "string"
    },
    "didit_rule_runs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "didit_submission_error": {
      "type": "string"
    },
    "didit_submission_note": {
      "description": "Why the transaction was not sent to Didit (skipped) or the last submission error",
      "type": "string"
    },
    "didit_submission_status": {
      "default": "not_submitted",
      "enum": [
        "not_submitted",
        "submitted",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "didit_transaction_id": {
      "description": "Didit's returned transaction ID",
      "type": "string"
    },
    "direction": {
      "enum": [
        "inbound",
        "outbound"
      ],
      "type": "string"
    },
    "executed_at": {
      "format": "date-time",
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "fx": {
      "properties": {
        "amount_reporting": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "rate_date": {
          "type": "string"
        },
        "reporting_currency": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "historical": {
      "default": false,
      "type": "boolean"
    },
    "ingest_batch_id": {
      "type": "string"
    },
    "intended_at": {
      "format": "date-time",
      "type": "string"
    },
    "lifecycle": {
      "default": "booked",
      "enum": [
        "intended",
        "declined",
        "booked",
        "reversed",
        "corrected"
      ],
      "type": "string"
    },
    "our_transaction_id": {
      "description": "Our unique ID (<=128 chars) sent to Didit as transaction_id",
      "type": "string"
    },
    "own_transfer": {
      "default": false,
      "type": "boolean"
    },
    "received_at": {
      "format": "date-time",
      "type": "string"
    },
    "related_to": {
      "description": "Transaction id of the original booking for a reversal/correction",
      "type": "string"
    },
    "review_decision": {
      "description": "nullable",
      "enum": [
        "Approved",
        "Blocked",
        "Escalated"
      ],
      "type": "string"
    },
    "review_notes": {
      "description": "nullable",
      "type": "string"
    },
    "reviewed_at": {
      "description": "nullable",
      "format": "date-time",
      "type": "string"
    },
    "reviewed_by_user_id": {
      "description": "nullable",
      "type": "string"
    },
    "risk_level": {
      "description": "nullable",
      "type": "string"
    },
    "risk_score": {
      "description": "nullable",
      "type": "number"
    },
    "source_file_id": {
      "description": "StatementUpload id",
      "type": "string"
    },
    "source_type": {
      "default": "manual",
      "enum": [
        "manual",
        "api",
        "psd2",
        "upload_csv",
        "upload_xlsx",
        "upload_mt940",
        "upload_camt",
        "upload_pdf"
      ],
      "type": "string"
    },
    "status": {
      "default": "PENDING",
      "enum": [
        "PENDING",
        "APPROVED",
        "IN_REVIEW",
        "DECLINED",
        "AWAITING_USER"
      ],
      "type": "string"
    },
    "subject_entity_type": {
      "default": "person",
      "enum": [
        "person",
        "company"
      ],
      "type": "string"
    },
    "subject_full_name": {
      "type": "string"
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "transaction_category": {
      "enum": [
        "finance",
        "kyc",
        "travel_rule",
        "user_event",
        "audit_trail_event",
        "gambling_bet",
        "gambling_limit_change",
        "gambling_bonus_change"
      ],
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}