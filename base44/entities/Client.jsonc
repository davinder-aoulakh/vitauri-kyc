{
  "name": "Client",
  "properties": {
    "assigned_analyst_id": {
      "description": "FK to User",
      "type": "string"
    },
    "business_activity": {
      "description": "ORG only \u2014 description of the business",
      "type": "string"
    },
    "category": {
      "default": "Klant",
      "enum": [
        "Klant",
        "Prospect",
        "Lead",
        "Supplier",
        "Other"
      ],
      "type": "string"
    },
    "client_segment": {
      "description": "Peer group for behavioural comparison (e.g. NP_salaried, ORG_retail_SME). Set by compliance; used by future peer-group detection.",
      "type": "string"
    },
    "client_type": {
      "enum": [
        "NP",
        "ORG"
      ],
      "type": "string"
    },
    "contact_entries": {
      "description": "Multi-entry communication table \u2014 email/phone entries with a preferred flag per type",
      "items": {
        "properties": {
          "is_preferred": {
            "default": false,
            "type": "boolean"
          },
          "type": {
            "enum": [
              "email",
              "phone",
              "mobile"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "country_of_birth": {
      "description": "NP only",
      "type": "string"
    },
    "country_of_residence": {
      "description": "NP only",
      "type": "string"
    },
    "current_profile_id": {
      "description": "ExpectedProfile id",
      "type": "string"
    },
    "customer_risk_band": {
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ],
      "type": "string"
    },
    "customer_risk_score": {
      "type": "number"
    },
    "date_of_birth": {
      "description": "NP only",
      "format": "date",
      "type": "string"
    },
    "decease_date": {
      "description": "NP only",
      "format": "date",
      "type": "string"
    },
    "deleted_at": {
      "description": "Timestamp of deletion",
      "format": "date-time",
      "type": "string"
    },
    "deleted_by_user_id": {
      "description": "FK to User who deleted",
      "type": "string"
    },
    "deletion_reason": {
      "description": "Reason provided at time of deletion",
      "type": "string"
    },
    "didit_monitoring_job_id": {
      "description": "Didit async job ID for the most recent enable/disable monitoring request \u2014 used to confirm the outcome via webhook or poll",
      "type": "string"
    },
    "didit_ongoing_monitoring": {
      "default": "NotEnrolled",
      "description": "Status of Didit ongoing AML monitoring enrollment for this client",
      "enum": [
        "NotEnrolled",
        "Pending",
        "Active"
      ],
      "type": "string"
    },
    "employer_name": {
      "description": "NP only",
      "type": "string"
    },
    "entity_classification": {
      "description": "FATCA/CRS \u2014 FFI/NFFE/Active/Passive",
      "type": "string"
    },
    "external_id": {
      "description": "External CRM/system reference ID",
      "type": "string"
    },
    "fatca_reporting_status": {
      "type": "string"
    },
    "first_names": {
      "description": "NP only",
      "type": "string"
    },
    "full_name": {
      "description": "Full name (NP) or Legal name (ORG). For NP, auto-computed from first_names + last_name.",
      "type": "string"
    },
    "gender": {
      "default": "Unknown",
      "description": "NP only",
      "enum": [
        "Unknown",
        "Male",
        "Female",
        "Other"
      ],
      "type": "string"
    },
    "id_number": {
      "description": "NP only",
      "type": "string"
    },
    "id_type": {
      "description": "NP only \u2014 Passport, ID Card etc",
      "type": "string"
    },
    "initials": {
      "description": "NP only",
      "type": "string"
    },
    "is_deleted": {
      "default": false,
      "description": "Soft-delete flag",
      "type": "boolean"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "nl",
        "de",
        "fr",
        "es",
        "other"
      ],
      "type": "string"
    },
    "last_name": {
      "description": "NP only",
      "type": "string"
    },
    "last_review_date": {
      "format": "date",
      "type": "string"
    },
    "legal_form": {
      "description": "ORG only \u2014 BV, NV, Ltd etc",
      "type": "string"
    },
    "lei_code": {
      "description": "ORG only",
      "type": "string"
    },
    "nationality": {
      "description": "NP only",
      "type": "string"
    },
    "nature_of_business_code": {
      "description": "ORG only \u2014 optional NACE/ISIC code",
      "type": "string"
    },
    "next_review_date": {
      "format": "date",
      "type": "string"
    },
    "occupation": {
      "description": "NP only",
      "type": "string"
    },
    "place_of_birth": {
      "description": "NP only",
      "type": "string"
    },
    "postal_address": {
      "description": "Structured postal address (optional, if different from residential)",
      "properties": {
        "area": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "preferred_name": {
      "description": "NP only",
      "type": "string"
    },
    "primary_contact_email": {
      "description": "Mirrors the preferred 'email' entry in contact_entries",
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_phone": {
      "description": "Mirrors the preferred 'phone'/'mobile' entry in contact_entries",
      "type": "string"
    },
    "registered_address": {
      "description": "ORG only",
      "type": "string"
    },
    "registered_country": {
      "description": "ORG only",
      "type": "string"
    },
    "registration_number": {
      "description": "ORG only \u2014 KvK/Chamber of Commerce",
      "type": "string"
    },
    "residential_address": {
      "description": "Structured residential address",
      "properties": {
        "area": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "risk_classification": {
      "description": "Current risk classification",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ],
      "type": "string"
    },
    "sector": {
      "description": "ORG only",
      "type": "string"
    },
    "source_channel": {
      "default": "Manual",
      "enum": [
        "Manual",
        "Batch",
        "API_CRM"
      ],
      "type": "string"
    },
    "status": {
      "default": "Prospect",
      "enum": [
        "Prospect",
        "Active",
        "Inactive",
        "Former",
        "Rejected",
        "Unacceptable"
      ],
      "type": "string"
    },
    "tax_residency": {
      "description": "FATCA/CRS \u2014 TBD schema",
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tin": {
      "description": "FATCA/CRS TIN",
      "type": "string"
    },
    "tipping_off_lock": {
      "default": false,
      "type": "boolean"
    },
    "tipping_off_locked_at": {
      "format": "date-time",
      "type": "string"
    },
    "tipping_off_reason": {
      "type": "string"
    },
    "tm_enabled": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "tenant_id",
    "client_type",
    "full_name"
  ],
  "type": "object"
}