{
  "name": "Client",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "NP",
        "ORG"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Prospect",
        "Active",
        "Inactive",
        "Former",
        "Rejected",
        "Unacceptable"
      ],
      "default": "Prospect"
    },
    "full_name": {
      "type": "string",
      "description": "Full name (NP) or Legal name (ORG). For NP, auto-computed from first_names + last_name."
    },
    "first_names": {
      "type": "string",
      "description": "NP only"
    },
    "last_name": {
      "type": "string",
      "description": "NP only"
    },
    "initials": {
      "type": "string",
      "description": "NP only"
    },
    "preferred_name": {
      "type": "string",
      "description": "NP only"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Unknown",
        "Male",
        "Female",
        "Other"
      ],
      "default": "Unknown",
      "description": "NP only"
    },
    "category": {
      "type": "string",
      "enum": [
        "Klant",
        "Prospect",
        "Lead",
        "Supplier",
        "Other"
      ],
      "default": "Klant"
    },
    "external_id": {
      "type": "string",
      "description": "External CRM/system reference ID"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "NP only"
    },
    "decease_date": {
      "type": "string",
      "format": "date",
      "description": "NP only"
    },
    "nationality": {
      "type": "string",
      "description": "NP only"
    },
    "country_of_birth": {
      "type": "string",
      "description": "NP only"
    },
    "place_of_birth": {
      "type": "string",
      "description": "NP only"
    },
    "country_of_residence": {
      "type": "string",
      "description": "NP only"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "nl",
        "de",
        "fr",
        "es",
        "other"
      ],
      "default": "en"
    },
    "id_type": {
      "type": "string",
      "description": "NP only \u2014 Passport, ID Card etc"
    },
    "id_number": {
      "type": "string",
      "description": "NP only"
    },
    "residential_address": {
      "type": "object",
      "description": "Structured residential address",
      "properties": {
        "country": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "area": {
          "type": "string"
        }
      }
    },
    "postal_address": {
      "type": "object",
      "description": "Structured postal address (optional, if different from residential)",
      "properties": {
        "country": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "area": {
          "type": "string"
        }
      }
    },
    "contact_entries": {
      "type": "array",
      "description": "Multi-entry communication table \u2014 email/phone entries with a preferred flag per type",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "mobile"
            ]
          },
          "value": {
            "type": "string"
          },
          "is_preferred": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "registration_number": {
      "type": "string",
      "description": "ORG only \u2014 KvK/Chamber of Commerce"
    },
    "lei_code": {
      "type": "string",
      "description": "ORG only"
    },
    "registered_country": {
      "type": "string",
      "description": "ORG only"
    },
    "registered_address": {
      "type": "string",
      "description": "ORG only"
    },
    "sector": {
      "type": "string",
      "description": "ORG only"
    },
    "legal_form": {
      "type": "string",
      "description": "ORG only \u2014 BV, NV, Ltd etc"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string",
      "description": "Mirrors the preferred 'email' entry in contact_entries"
    },
    "primary_contact_phone": {
      "type": "string",
      "description": "Mirrors the preferred 'phone'/'mobile' entry in contact_entries"
    },
    "risk_classification": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ],
      "description": "Current risk classification"
    },
    "assigned_analyst_id": {
      "type": "string",
      "description": "FK to User"
    },
    "source_channel": {
      "type": "string",
      "enum": [
        "Manual",
        "Batch",
        "API_CRM"
      ],
      "default": "Manual"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "last_review_date": {
      "type": "string",
      "format": "date"
    },
    "tax_residency": {
      "type": "string",
      "description": "FATCA/CRS \u2014 TBD schema"
    },
    "tin": {
      "type": "string",
      "description": "FATCA/CRS TIN"
    },
    "entity_classification": {
      "type": "string",
      "description": "FATCA/CRS \u2014 FFI/NFFE/Active/Passive"
    },
    "fatca_reporting_status": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete flag"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of deletion"
    },
    "deleted_by_user_id": {
      "type": "string",
      "description": "FK to User who deleted"
    },
    "deletion_reason": {
      "type": "string",
      "description": "Reason provided at time of deletion"
    }
  },
  "required": [
    "tenant_id",
    "client_type",
    "full_name"
  ]
}