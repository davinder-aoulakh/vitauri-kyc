{
  "name": "QualitySample",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "below_the_line",
        "file_review",
        "ai_shadow"
      ]
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "population_size": {
      "type": "number"
    },
    "sample_size": {
      "type": "number"
    },
    "scenario_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref_type": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ok",
              "missed_signal",
              "wrongly_closed",
              "citation_error",
              "pending"
            ]
          },
          "reviewer_user_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "closed_by_user_id": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string"
          }
        }
      }
    },
    "findings_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "default": "open"
    },
    "reviewer_user_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "description": "Computed summary (ai_shadow: missed, wrongly_closed, close_proposals, citations_ok_pct ...; others: reviewed, pending)"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "completed_by_user_id": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean",
      "default": false,
      "description": "Population was capped while sampling"
    }
  },
  "required": [
    "tenant_id",
    "sample_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}