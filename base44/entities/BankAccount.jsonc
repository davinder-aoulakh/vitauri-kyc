{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "iban_or_number": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "bic": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "holder_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "api",
        "psd2",
        "upload",
        "manual"
      ]
    },
    "is_customer_owned": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "paused"
      ],
      "default": "active"
    },
    "opened_at": {
      "type": "string",
      "format": "date"
    },
    "closed_at": {
      "type": "string",
      "format": "date"
    },
    "closed_reason": {
      "type": "string"
    },
    "expected_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "own",
        "external_psd2",
        "joint",
        "business"
      ],
      "description": "Own account at the institution, the customer's external account (PSD2), joint account, or business account"
    },
    "holders": {
      "type": "array",
      "description": "Account holders (joint and business accounts can have several)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "related_party_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "iban_or_number"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Tenant Admin"
          }
        }
      ]
    }
  }
}
