{
  "name": "TmRule",
  "properties": {
    "approval_status": {
      "default": "not_requested",
      "enum": [
        "not_requested",
        "requested",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "type": "string"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "backtest_id": {
      "type": "string"
    },
    "change_note": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "definition": {
      "description": "Didit rule JSON",
      "type": "object"
    },
    "didit_library_id": {
      "description": "Didit library_key the draft was imported from",
      "type": "string"
    },
    "didit_rule_history": {
      "description": "Didit rules replaced when rule updates are unavailable: { old_didit_rule_id, new_didit_rule_id, old_title, new_title, old_disabled, at }",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "didit_rule_id": {
      "type": "string"
    },
    "drift_detected_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_synced_at": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "description": "Shared by every version of the same rule",
      "type": "string"
    },
    "mode": {
      "default": "draft",
      "enum": [
        "draft",
        "test",
        "active",
        "disabled",
        "retired",
        "unmanaged"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nl_source": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "previous_version_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "requested_by_user_id": {
      "type": "string"
    },
    "retired_at": {
      "format": "date-time",
      "type": "string"
    },
    "retired_by_user_id": {
      "type": "string"
    },
    "review_date": {
      "format": "date",
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "seed_key": {
      "description": "Makes starter-rule seeding idempotent, e.g. starter:S-07a",
      "type": "string"
    },
    "source": {
      "description": "Where the rule came from. Empty = authored in Vitauri.",
      "enum": [
        "vitauri",
        "didit_library",
        "didit_console"
      ],
      "type": "string"
    },
    "sync_error": {
      "type": "string"
    },
    "sync_status": {
      "default": "not_synced",
      "enum": [
        "not_synced",
        "synced",
        "failed",
        "drift"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "unmanaged_ack_at": {
      "format": "date-time",
      "type": "string"
    },
    "unmanaged_ack_by_user_id": {
      "type": "string"
    },
    "unmanaged_ack_reason": {
      "description": "Why an unmanaged Didit rule was marked as known",
      "type": "string"
    },
    "unmanaged_since": {
      "description": "When the nightly check first found this rule in Didit without a Vitauri rule (mode unmanaged)",
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}