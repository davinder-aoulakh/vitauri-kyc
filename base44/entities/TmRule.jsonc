{
  "name": "TmRule",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "definition": {
      "type": "object",
      "description": "Didit rule JSON"
    },
    "nl_source": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "draft",
        "test",
        "active",
        "disabled",
        "retired"
      ],
      "default": "draft"
    },
    "didit_rule_id": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "synced",
        "failed",
        "drift"
      ],
      "default": "not_synced"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_error": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "backtest_id": {
      "type": "string"
    },
    "change_note": {
      "type": "string"
    },
    "previous_version_id": {
      "type": "string"
    },
    "lineage_id": {
      "type": "string",
      "description": "Shared by every version of the same rule"
    },
    "owner_user_id": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "approved",
        "rejected"
      ],
      "default": "not_requested"
    },
    "requested_by_user_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_by_user_id": {
      "type": "string"
    },
    "drift_detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "seed_key": {
      "type": "string",
      "description": "Makes starter-rule seeding idempotent, e.g. starter:S-07a"
    },
    "didit_rule_history": {
      "type": "array",
      "description": "Didit rules replaced when rule updates are unavailable: { old_didit_rule_id, new_didit_rule_id, old_title, new_title, old_disabled, at }",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}