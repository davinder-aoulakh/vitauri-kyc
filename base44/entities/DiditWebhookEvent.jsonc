{
  "name": "DiditWebhookEvent",
  "properties": {
    "attempts": {
      "type": "number"
    },
    "error": {
      "description": "Short error of the last failed attempt (no secrets)",
      "type": "string"
    },
    "event_id": {
      "description": "Didit event_id \u2014 unique per webhook delivery attempt, used for idempotency",
      "type": "string"
    },
    "processed_at": {
      "format": "date-time",
      "type": "string"
    },
    "processing_state": {
      "description": "received = in progress; failed events may be delivered again and are reprocessed. Missing on legacy rows (treated as processed).",
      "enum": [
        "received",
        "processed",
        "failed"
      ],
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "webhook_type": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "event_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false
  }
}