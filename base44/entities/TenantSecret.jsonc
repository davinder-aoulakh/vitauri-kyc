{
  "name": "TenantSecret",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "One record per tenant. Backend functions only."
    },
    "didit_api_key": {
      "type": "string",
      "description": "Didit x-api-key. Never readable by app users."
    },
    "didit_webhook_secret": {
      "type": "string",
      "description": "Didit webhook signing secret. Never readable by app users."
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false
  }
}