{
  "name": "TenantSecret",
  "properties": {
    "anthropic_api_key": {
      "description": "Anthropic (Claude) API key for the KYC Screener. Never readable by app users.",
      "type": "string"
    },
    "anthropic_rotated_at": {
      "format": "date-time",
      "type": "string"
    },
    "anthropic_updated_by_user_id": {
      "type": "string"
    },
    "didit_api_key": {
      "description": "Didit x-api-key. Never readable by app users.",
      "type": "string"
    },
    "didit_webhook_secret": {
      "description": "Didit webhook signing secret. Never readable by app users.",
      "type": "string"
    },
    "rotated_at": {
      "format": "date-time",
      "type": "string"
    },
    "tenant_id": {
      "description": "One record per tenant. Backend functions only.",
      "type": "string"
    },
    "updated_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false
  }
}