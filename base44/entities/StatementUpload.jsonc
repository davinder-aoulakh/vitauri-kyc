{
  "name": "StatementUpload",
  "properties": {
    "account_ref": {
      "description": "Account number / IBAN read from the statement",
      "type": "string"
    },
    "ai_run_id": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "batch_id": {
      "description": "TransactionIngestBatch created on commit",
      "type": "string"
    },
    "blocking": {
      "description": "Checks that block processing, e.g. [{code: iban_mismatch, file_iban, account_iban}]",
      "items": {
        "properties": {
          "account_iban": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "file_iban": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "client_id": {
      "type": "string"
    },
    "closing_balance": {
      "type": "number"
    },
    "column_map": {
      "type": "object"
    },
    "committed_at": {
      "format": "date-time",
      "type": "string"
    },
    "committed_by_user_id": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "duplicates_removed": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "extracted_count": {
      "type": "number"
    },
    "file_hash": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "format": {
      "enum": [
        "csv",
        "xlsx",
        "mt940",
        "camt053",
        "pdf"
      ],
      "type": "string"
    },
    "gaps": {
      "items": {
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "historical_count": {
      "description": "Rows older than the tenant historical window (stored, not sent to Didit, no alerts)",
      "type": "number"
    },
    "opening_balance": {
      "type": "number"
    },
    "own_transfers": {
      "type": "number"
    },
    "parsed_rows": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "period_from": {
      "format": "date",
      "type": "string"
    },
    "period_to": {
      "format": "date",
      "type": "string"
    },
    "reconcile_diff": {
      "description": "Opening + movements - closing, set by parseStatement",
      "type": "number"
    },
    "reconciles": {
      "type": "boolean"
    },
    "reversals_linked": {
      "type": "number"
    },
    "status": {
      "default": "uploaded",
      "enum": [
        "uploaded",
        "parsing",
        "review",
        "committed",
        "failed",
        "committing"
      ],
      "type": "string"
    },
    "tamper_signals": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "template": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "file_url"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}