{
  "name": "StatementUpload",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_hash": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "csv",
        "xlsx",
        "mt940",
        "camt053",
        "pdf"
      ]
    },
    "template": {
      "type": "string"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "opening_balance": {
      "type": "number"
    },
    "closing_balance": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "reconciles": {
      "type": "boolean"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "tamper_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extracted_count": {
      "type": "number"
    },
    "duplicates_removed": {
      "type": "number"
    },
    "own_transfers": {
      "type": "number"
    },
    "reversals_linked": {
      "type": "number"
    },
    "parsed_rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "column_map": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "parsing",
        "review",
        "committed",
        "failed"
      ],
      "default": "uploaded"
    },
    "error": {
      "type": "string"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "committed_by_user_id": {
      "type": "string"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}