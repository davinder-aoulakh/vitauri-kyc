{
  "name": "FxRate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "base": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "date",
    "base",
    "quote",
    "rate"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}