{
  "name": "QcFinding",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case_value": {
      "type": "string"
    },
    "check": {
      "enum": [
        "case",
        "report"
      ],
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "datapoint_ref": {
      "type": "string"
    },
    "fingerprint": {
      "description": "rule + datapoint key; used to carry decisions across rounds",
      "type": "string"
    },
    "human": {
      "description": "Human-action card data: { kind, question, comparison[], evidence_items[], outreach_question }",
      "type": "object"
    },
    "kind": {
      "enum": [
        "auto",
        "human"
      ],
      "type": "string"
    },
    "owner": {
      "description": "Agent name or 'Analyst (human)'",
      "type": "string"
    },
    "qc_run_id": {
      "type": "string"
    },
    "report_value": {
      "type": "string"
    },
    "resolution_text": {
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_by_name": {
      "type": "string"
    },
    "resolved_in_round": {
      "type": "number"
    },
    "round": {
      "type": "number"
    },
    "rule_ref": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "blocker",
        "major",
        "minor"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "returned",
        "needs_human",
        "resolved",
        "dismissed",
        "carried"
      ],
      "type": "string"
    },
    "step": {
      "description": "Case step id the finding belongs to",
      "type": "number"
    },
    "step_label": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "qc_run_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false,
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    }
  }
}