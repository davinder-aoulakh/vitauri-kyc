{
  "name": "Notification",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Recipient user FK"
    },
    "type": {
      "type": "string",
      "enum": [
        "case_assigned",
        "sign_off_request",
        "sign_off_decision",
        "outreach_response",
        "monitoring_alert",
        "control_measure_due",
        "periodic_review_created",
        "tm_coverage_summary",
        "edr_proposed",
        "tm_deadline",
        "tm_escalation"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "link_case_id": {
      "type": "string"
    },
    "link_client_id": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link_alert_id": {
      "type": "string",
      "description": "TmAlert this notification is about"
    },
    "link_tm_case_id": {
      "type": "string",
      "description": "TmCase this notification is about"
    },
    "dedupe_key": {
      "type": "string",
      "description": "user:item:kind - used to avoid duplicate deadline notifications within 12h"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "type",
    "title"
  ]
}