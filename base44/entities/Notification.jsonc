{
  "name": "Notification",
  "properties": {
    "body": {
      "type": "string"
    },
    "dedupe_key": {
      "description": "user:item:kind - used to avoid duplicate deadline notifications within 12h",
      "type": "string"
    },
    "is_read": {
      "default": false,
      "type": "boolean"
    },
    "link_alert_id": {
      "description": "TmAlert this notification is about",
      "type": "string"
    },
    "link_case_id": {
      "type": "string"
    },
    "link_client_id": {
      "type": "string"
    },
    "link_fiu_report_id": {
      "description": "FiuReport this notification is about",
      "type": "string"
    },
    "link_kyc_case_id": {
      "type": "string"
    },
    "link_tm_case_id": {
      "description": "TmCase this notification is about",
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "enum": [
        "case_assigned",
        "sign_off_request",
        "sign_off_decision",
        "outreach_response",
        "monitoring_alert",
        "control_measure_due",
        "periodic_review_created",
        "tm_coverage_summary",
        "edr_proposed",
        "tm_deadline",
        "tm_escalation",
        "fiu_report_review",
        "tm_rule_approval",
        "tm_rule_drift",
        "tm_quality_finding",
        "tm_retention_digest",
        "edr_trigger",
        "document_check"
      ],
      "type": "string"
    },
    "user_id": {
      "description": "Recipient user FK",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "type",
    "title"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}