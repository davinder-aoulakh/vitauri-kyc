{
  "name": "OutreachRequest",
  "properties": {
    "access_token": {
      "description": "Secure unique token for client portal",
      "type": "string"
    },
    "case_id": {
      "description": "FK to KycCase \u2014 omitted for standalone outreach",
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "deadline": {
      "format": "date",
      "type": "string"
    },
    "delivery_channel": {
      "default": "Email",
      "enum": [
        "Email",
        "SMS",
        "Portal"
      ],
      "type": "string"
    },
    "email_template_body": {
      "description": "Resolved email template HTML body stored at creation time \u2014 used by sendEmail instead of message",
      "type": "string"
    },
    "items": {
      "description": "Requested data points and documents",
      "items": {
        "properties": {
          "condition_depends_on_item_id": {
            "type": "string"
          },
          "condition_equals_value": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "didit_session_id": {
            "description": "Didit session UUID for this IDV field",
            "type": "string"
          },
          "didit_session_status": {
            "description": "Raw Didit session status e.g. Approved, Declined, In Review",
            "type": "string"
          },
          "didit_session_url": {
            "description": "Didit hosted verification URL for this session",
            "type": "string"
          },
          "didit_workflow_id": {
            "description": "Didit workflow the session was created with (resolved server-side)",
            "type": "string"
          },
          "didit_workflow_name": {
            "type": "string"
          },
          "field_options": {
            "description": "Choices for dropdown and multi_select field types",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "field_type": {
            "description": "Rich field type \u2014 controls how the portal renders the input",
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "idv_accepted_doc_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "idv_aml_adverse_media": {
            "type": "boolean"
          },
          "idv_aml_approve_threshold": {
            "type": "number"
          },
          "idv_aml_country_weight": {
            "type": "number"
          },
          "idv_aml_dob_weight": {
            "type": "number"
          },
          "idv_aml_hits": {
            "type": "number"
          },
          "idv_aml_match_threshold": {
            "type": "number"
          },
          "idv_aml_name_weight": {
            "type": "number"
          },
          "idv_aml_ongoing_monitoring": {
            "type": "boolean"
          },
          "idv_aml_review_threshold": {
            "type": "number"
          },
          "idv_aml_screenings": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "idv_aml_status": {
            "type": "string"
          },
          "idv_aml_warnings": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "idv_auto_proceed": {
            "type": "boolean"
          },
          "idv_checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "idv_confidence": {
            "type": "number"
          },
          "idv_docs_created_for_session": {
            "description": "Session ID for which Document records have already been created \u2014 dedup guard",
            "type": "string"
          },
          "idv_document_expiry": {
            "format": "date",
            "type": "string"
          },
          "idv_document_number": {
            "type": "string"
          },
          "idv_document_type": {
            "type": "string"
          },
          "idv_extracted_address": {
            "description": "Raw Didit address string",
            "type": "string"
          },
          "idv_extracted_dob": {
            "format": "date",
            "type": "string"
          },
          "idv_extracted_first_name": {
            "type": "string"
          },
          "idv_extracted_gender": {
            "description": "Raw Didit gender code \u2014 M, F, or U",
            "type": "string"
          },
          "idv_extracted_last_name": {
            "type": "string"
          },
          "idv_extracted_nationality": {
            "type": "string"
          },
          "idv_face_raw": {
            "type": "object"
          },
          "idv_failure_reason": {
            "type": "string"
          },
          "idv_issuing_country": {
            "type": "string"
          },
          "idv_liveness_passed": {
            "type": "boolean"
          },
          "idv_liveness_raw": {
            "type": "object"
          },
          "idv_liveness_required": {
            "type": "boolean"
          },
          "idv_liveness_score": {
            "type": "number"
          },
          "idv_min_match_score": {
            "type": "number"
          },
          "idv_profile_applied_fields": {
            "description": "Client profile field keys already applied from this item's IDV extraction \u2014 prevents re-prompting on pipeline re-run",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "idv_provider": {
            "type": "string"
          },
          "idv_similarity_score": {
            "description": "Face match % score",
            "type": "number"
          },
          "idv_status": {
            "enum": [
              "Pending",
              "Pass",
              "Fail",
              "Inconclusive",
              "Expired"
            ],
            "type": "string"
          },
          "idv_workflow_id": {
            "type": "string"
          },
          "idv_workflow_name": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "item_type": {
            "enum": [
              "document",
              "data_point"
            ],
            "type": "string"
          },
          "kyb_status": {
            "description": "Didit KYB session status for a kyb_verification item",
            "type": "string"
          },
          "kyb_verification_id": {
            "description": "KybVerification record for a kyb_verification item",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "response_text": {
            "type": "string"
          },
          "section_title": {
            "type": "string"
          },
          "sort_order": {
            "description": "Display order within this request",
            "type": "number"
          },
          "status": {
            "enum": [
              "Requested",
              "Received",
              "Verified",
              "Missing"
            ],
            "type": "string"
          },
          "validation_accepted_file_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "validation_max_file_size_mb": {
            "type": "number"
          },
          "validation_max_length": {
            "type": "number"
          },
          "validation_max_value": {
            "type": "number"
          },
          "validation_min_length": {
            "type": "number"
          },
          "validation_min_value": {
            "type": "number"
          },
          "validation_required": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "description": "Short custom note from analyst \u2014 NOT the email template body",
      "type": "string"
    },
    "recipient_email": {
      "description": "Recipient override (e.g. the related party's email) instead of the client's primary contact",
      "type": "string"
    },
    "related_party_id": {
      "description": "Set when this outreach asks a related party (UBO/director) of an organisation client to verify their identity",
      "type": "string"
    },
    "standalone": {
      "default": false,
      "description": "True for outreach not linked to a KYC case",
      "type": "boolean"
    },
    "status": {
      "default": "Draft",
      "enum": [
        "Draft",
        "Sent",
        "Viewed",
        "Partial_Response",
        "Complete"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "token_expires_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ],
  "type": "object"
}