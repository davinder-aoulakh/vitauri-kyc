{
  "name": "KycCase",
  "properties": {
    "ai_outputs": {
      "description": "Persisted AI assistant outputs keyed by step number.",
      "type": "object"
    },
    "assigned_analyst_id": {
      "description": "FK to User",
      "type": "string"
    },
    "case_notes": {
      "type": "string"
    },
    "case_notes_threads": {
      "description": "Array of threaded notes with replies",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "case_type": {
      "enum": [
        "Onboarding",
        "Periodic_Review",
        "Event_Driven_Review",
        "Offboarding"
      ],
      "type": "string"
    },
    "client_id": {
      "description": "FK to Client",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "compliance_advisory_note": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "expected_transaction_behavior": {
      "type": "string"
    },
    "is_re_onboarding": {
      "default": false,
      "type": "boolean"
    },
    "kyc_txn_analysis_id": {
      "type": "string"
    },
    "osint_cache": {
      "type": "string"
    },
    "previous_case_id": {
      "type": "string"
    },
    "profile_proposal_id": {
      "type": "string"
    },
    "profile_suggestions": {
      "description": "Structured field suggestions for the Profile Verification step.",
      "type": "object"
    },
    "purpose_nature_text": {
      "type": "string"
    },
    "risk_assessment_meta": {
      "description": "Persisted S-090/S-092 state: { selections, selectionConfirmed, narrativeAccepted, overallNarratives, entityOverrides, consolidatedOverride }",
      "type": "object"
    },
    "risk_classification": {
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ],
      "type": "string"
    },
    "sign_off_approved_at": {
      "format": "date-time",
      "type": "string"
    },
    "sign_off_approved_by": {
      "type": "string"
    },
    "sign_off_rejection_reason": {
      "type": "string"
    },
    "sign_off_submitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "sign_off_submitted_by": {
      "type": "string"
    },
    "sof_narrative": {
      "type": "string"
    },
    "sow_applicable": {
      "default": false,
      "type": "boolean"
    },
    "status": {
      "default": "Draft",
      "enum": [
        "Draft",
        "In_Progress",
        "Outreach_Pending",
        "Screening",
        "Assessment",
        "QC",
        "Compliance_Review",
        "Sign_Off_Pending",
        "Approved",
        "Rejected",
        "Closed"
      ],
      "type": "string"
    },
    "step_1_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_2_not_required": {
      "default": false,
      "description": "Identity Verification \u2014 waived for existing/returning clients",
      "type": "boolean"
    },
    "step_2_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_3_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_4_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_5_not_required": {
      "default": false,
      "description": "Source of Funds/Wealth \u2014 conditional on risk level",
      "type": "boolean"
    },
    "step_5_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_6_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_7_not_required": {
      "default": false,
      "description": "Control Measures \u2014 conditional on risk outcome",
      "type": "boolean"
    },
    "step_7_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_8_status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "step_9_status": {
      "default": "not_started",
      "description": "Profile Verification \u2014 displayed as the 2nd step, right after Outreach & Documents",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "flagged"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tm_alert_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tm_case_id": {
      "type": "string"
    },
    "tm_context": {
      "description": "Snapshot when an event-driven review is opened from TM",
      "type": "object"
    },
    "tm_outcome_synced_at": {
      "format": "date-time",
      "type": "string"
    },
    "tm_risk_divergence": {
      "description": "Rationale when the KYC risk rating is below the dynamic monitoring risk band: { kyc_rating, dynamic_band, dynamic_score, rationale, by_user_id, by_name, at }",
      "type": "object"
    },
    "trigger_reason": {
      "description": "EDR trigger description",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "case_type"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}