{
  "name": "ClientRelatedPartyLink",
  "properties": {
    "added_by_user_id": {
      "type": "string"
    },
    "client_id": {
      "description": "FK to Client",
      "type": "string"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "related_party_id": {
      "description": "FK to RelatedParty",
      "type": "string"
    },
    "role": {
      "description": "UBO, Director, Shareholder etc. Several roles are joined: 'Director, Shareholder, UBO' (see roles)",
      "type": "string"
    },
    "roles": {
      "description": "All roles of this party for the client, e.g. ['Director','Shareholder','UBO']",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tenant_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "related_party_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}