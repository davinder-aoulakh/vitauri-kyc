{
  "name": "ClientRelatedPartyLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client"
    },
    "related_party_id": {
      "type": "string",
      "description": "FK to RelatedParty"
    },
    "role": {
      "type": "string",
      "description": "UBO, Director, Shareholder etc"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "added_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "related_party_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}