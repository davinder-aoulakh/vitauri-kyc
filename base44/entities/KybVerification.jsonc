{
  "name": "KybVerification",
  "properties": {
    "aml": {
      "description": "Company AML summary {status, total_hits, screening_hit_ids}",
      "type": "object"
    },
    "business_session_id": {
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "client_id": {
      "description": "Organisation client (Didit vendor_data for the business)",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "type": "string"
    },
    "didit_session_id": {
      "type": "string"
    },
    "didit_session_url": {
      "type": "string"
    },
    "documents": {
      "description": "document_verifications items: {didit_uuid, document_group, document_subtype, status, original_filename, document_id, is_tampered}",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "feature_statuses": {
      "description": "Per-feature status by node_id",
      "type": "object"
    },
    "item_id": {
      "type": "string"
    },
    "key_people_found": {
      "description": "Officers and beneficial owners reported by the registry / key_people_checks",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "kyc_case_id": {
      "type": "string"
    },
    "last_event_id": {
      "type": "string"
    },
    "outreach_id": {
      "type": "string"
    },
    "registry": {
      "description": "Latest registry_checks[].company (no media URLs)",
      "type": "object"
    },
    "registry_status": {
      "type": "string"
    },
    "resubmit_info": {
      "type": "object"
    },
    "status": {
      "default": "Not Started",
      "description": "Exact Didit session status literal",
      "enum": [
        "Not Started",
        "In Progress",
        "Awaiting User",
        "In Review",
        "Approved",
        "Declined",
        "Resubmitted",
        "Abandoned",
        "Expired",
        "Kyc Expired"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "vendor_business_id": {
      "type": "string"
    },
    "vitauri_review": {
      "description": "Reviewer acceptance in Vitauri while Didit is In Review only on key-people checks: {decision:'accepted', reason, by_user_id, by_name, at, didit_status_at_decision, open_checks:[]}. Didit's status is not changed.",
      "type": "object"
    },
    "workflow_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}