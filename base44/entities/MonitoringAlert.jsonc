{
  "name": "MonitoringAlert",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "related_party_id": {
      "type": "string",
      "description": "nullable"
    },
    "entity_name": {
      "type": "string",
      "description": "Denormalized"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Client",
        "Related_Party"
      ]
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "Screening_Hit",
        "Register_Change",
        "Manual_Flag"
      ]
    },
    "source": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "ai_impact_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Under_Review",
        "Dismissed",
        "Escalated_to_EDR"
      ],
      "default": "New"
    },
    "assigned_analyst_id": {
      "type": "string"
    },
    "dismissed_justification": {
      "type": "string"
    },
    "edr_case_id": {
      "type": "string",
      "description": "If escalated to EDR, FK to new KycCase"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "alert_type"
  ]
}