{
  "name": "KycTransactionAnalysis",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "statement_upload_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "income_by_category": {
      "type": "object"
    },
    "spend_by_category": {
      "type": "object"
    },
    "avg_inbound_month": {
      "type": "number"
    },
    "avg_outbound_month": {
      "type": "number"
    },
    "txn_count": {
      "type": "number"
    },
    "integrity_summary": {
      "type": "string"
    },
    "risk_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ai_conclusion": {
      "type": "string"
    },
    "ai_run_id": {
      "type": "string"
    },
    "analyst_conclusion": {
      "type": "string"
    },
    "proposed_profile_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "signed_off"
      ],
      "default": "draft"
    },
    "signed_off_by_user_id": {
      "type": "string"
    },
    "signed_off_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string"
    },
    "avg_inbound_count_month": {
      "type": "number"
    },
    "cash_share": {
      "type": "number",
      "description": "Cash volume as a share (0-1) of total volume"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consistency_with_occupation": {
      "type": "string",
      "enum": [
        "consistent",
        "partly",
        "inconsistent",
        "unknown"
      ],
      "default": "unknown"
    },
    "insufficient_evidence": {
      "type": "boolean",
      "default": false
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "reconciles": {
          "type": "boolean"
        },
        "gap_count": {
          "type": "number"
        },
        "tamper_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proposed_profile_limits": {
      "type": "object",
      "description": "AI proposed limits: inbound_max_month, inbound_max_count_month, outbound_foreign_max_month, allowed_countries, cash_max_month"
    },
    "proposed_profile_version": {
      "type": "number"
    },
    "run_by_user_id": {
      "type": "string"
    },
    "run_by_name": {
      "type": "string"
    },
    "signed_off_by_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "case_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}