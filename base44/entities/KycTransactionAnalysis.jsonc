{
  "name": "KycTransactionAnalysis",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "statement_upload_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "income_by_category": {
      "type": "object"
    },
    "spend_by_category": {
      "type": "object"
    },
    "avg_inbound_month": {
      "type": "number"
    },
    "avg_outbound_month": {
      "type": "number"
    },
    "txn_count": {
      "type": "number"
    },
    "integrity_summary": {
      "type": "string"
    },
    "risk_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ai_conclusion": {
      "type": "string"
    },
    "ai_run_id": {
      "type": "string"
    },
    "analyst_conclusion": {
      "type": "string"
    },
    "proposed_profile_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "signed_off"
      ],
      "default": "draft"
    },
    "signed_off_by_user_id": {
      "type": "string"
    },
    "signed_off_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "case_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}