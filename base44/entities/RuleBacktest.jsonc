{
  "name": "RuleBacktest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "rule_version": {
      "type": "number"
    },
    "window_from": {
      "type": "string",
      "format": "date"
    },
    "window_to": {
      "type": "string",
      "format": "date"
    },
    "hits_txn": {
      "type": "number"
    },
    "hits_customers": {
      "type": "number"
    },
    "known_cases_total": {
      "type": "number"
    },
    "known_cases_found": {
      "type": "number"
    },
    "est_alerts_month": {
      "type": "number"
    },
    "raw": {
      "type": "object"
    },
    "run_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "rule_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}