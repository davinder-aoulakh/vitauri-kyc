{
  "name": "EdrTrigger",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "ubo_change",
        "director_change",
        "business_activity_change",
        "country_change",
        "screening_hit",
        "risk_band_rise",
        "profile_breach",
        "tm_case",
        "transaction_verification",
        "id_expiry",
        "address_change",
        "tm_alert_frequency",
        "tm_new_country",
        "tm_investigation_outcome"
      ]
    },
    "source_ref": {
      "type": "string"
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "dismissed"
      ],
      "default": "proposed"
    },
    "kyc_case_id": {
      "type": "string"
    },
    "decided_by_user_id": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismiss_reason": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "response": {
      "type": "string",
      "enum": [
        "no_action",
        "targeted_check",
        "risk_reassessment",
        "full_cdd_refresh"
      ],
      "description": "Graduated response chosen on the Change of circumstances page"
    },
    "response_reason": {
      "type": "string"
    },
    "restricted": {
      "type": "boolean",
      "default": false,
      "description": "Details are for AML and Compliance only"
    },
    "source_label": {
      "type": "string",
      "description": "Where the event came from, e.g. Screening, Investigation, Register"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    }
  }
}