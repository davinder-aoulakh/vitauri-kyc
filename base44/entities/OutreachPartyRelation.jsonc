{
  "name": "OutreachPartyRelation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "from_party_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "from_kind": {
      "type": "string",
      "enum": [
        "person",
        "company"
      ]
    },
    "to_party_id": {
      "type": "string",
      "description": "Empty means the client itself"
    },
    "relation": {
      "type": "string",
      "enum": [
        "owns",
        "director_of",
        "authorised_rep_of",
        "ubo_of"
      ]
    },
    "pct": {
      "type": "number"
    },
    "effective_pct": {
      "type": "number"
    },
    "authority": {
      "type": "string"
    },
    "authority_note": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "relation"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "__backend_only__"
      }
    },
    "delete": false
  }
}
