{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Template display name"
    },
    "situation": {
      "type": "string",
      "enum": [
        "Welcome",
        "First_Reminder",
        "Second_Reminder",
        "Third_Reminder",
        "Additional_Info",
        "Documentation_Request",
        "Conversation_Invite_NP",
        "Conversation_Invite_ORG",
        "Conversation_Invite_Related_Party",
        "Conversation_New_Message",
        "Conversation_Reminder"
      ]
    },
    "subject": {
      "type": "string"
    },
    "body_html": {
      "type": "string",
      "description": "HTML email body with {{variables}}"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "situation",
    "subject",
    "body_html"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}
