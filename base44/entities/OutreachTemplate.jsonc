{
  "name": "OutreachTemplate",
  "properties": {
    "case_types": {
      "items": {
        "enum": [
          "Onboarding",
          "Periodic_Review",
          "Event_Driven_Review",
          "Offboarding"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "client_types": {
      "description": "Which client types this template applies to",
      "items": {
        "enum": [
          "NP",
          "ORG"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "condition_depends_on_item_id": {
      "description": "Item ID this field conditionally depends on",
      "type": "string"
    },
    "condition_equals_value": {
      "description": "Value the dependency field must equal for this field to show",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "field_options": {
      "description": "Choices for dropdown and multi_select field types",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "field_type": {
      "description": "Rich field type. Defaults: 'document' \u2192 file_upload, 'data_point' \u2192 textarea. phone = country code + number; address = street/number/zipcode/city/country; country = country picker",
      "enum": [
        "file_upload",
        "text",
        "textarea",
        "number",
        "date",
        "dropdown",
        "multi_select",
        "checkbox",
        "yes_no",
        "signature",
        "section_header",
        "id_verification",
        "kyb_verification",
        "phone",
        "address",
        "country"
      ],
      "type": "string"
    },
    "idv_accepted_doc_types": {
      "description": "Accepted document types for identity verification",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "idv_auto_proceed": {
      "default": false,
      "description": "Auto-complete item when IDV passes",
      "type": "boolean"
    },
    "idv_liveness_required": {
      "default": true,
      "description": "Whether liveness check is required",
      "type": "boolean"
    },
    "idv_min_match_score": {
      "default": 75,
      "description": "Minimum face match % to pass",
      "type": "number"
    },
    "idv_workflow_id": {
      "description": "Didit workflow UUID override for this IDV field",
      "type": "string"
    },
    "idv_workflow_name": {
      "description": "Display name of the selected Didit workflow",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "is_mandatory": {
      "default": false,
      "type": "boolean"
    },
    "item_type": {
      "description": "Legacy field \u2014 kept for backward compatibility. Use field_type for new records.",
      "enum": [
        "document",
        "data_point"
      ],
      "type": "string"
    },
    "label": {
      "description": "Display name e.g. 'Passport Copy'",
      "type": "string"
    },
    "profile_field": {
      "description": "KYC client field this question fills, e.g. full_name, date_of_birth, nationality, primary_contact_phone, primary_contact_email, residential_address, registered_address. Answers go to Profile Verification for analyst review; existing data can be shown to the client to check.",
      "type": "string"
    },
    "section_title": {
      "description": "Display title when field_type is 'section_header'",
      "type": "string"
    },
    "sort_order": {
      "default": 0,
      "type": "number"
    },
    "tenant_id": {
      "type": "string"
    },
    "validation_accepted_file_types": {
      "description": "Accepted file extensions for file_upload e.g. ['pdf','jpg','png']",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_max_file_size_mb": {
      "default": 25,
      "description": "Max file size in MB for file_upload",
      "type": "number"
    },
    "validation_max_length": {
      "description": "Maximum character length for text/textarea",
      "type": "number"
    },
    "validation_max_value": {
      "description": "Maximum value for number fields",
      "type": "number"
    },
    "validation_min_length": {
      "description": "Minimum character length for text/textarea",
      "type": "number"
    },
    "validation_min_value": {
      "description": "Minimum value for number fields",
      "type": "number"
    },
    "validation_required": {
      "default": false,
      "description": "Must be completed before submission",
      "type": "boolean"
    }
  },
  "required": [
    "tenant_id",
    "label"
  ],
  "type": "object"
}