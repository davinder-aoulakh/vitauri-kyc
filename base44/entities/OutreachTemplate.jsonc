{
  "name": "OutreachTemplate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "Display name e.g. 'Passport Copy'"
    },
    "description": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "document",
        "data_point"
      ]
    },
    "client_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NP",
          "ORG"
        ]
      },
      "description": "Which client types this template applies to"
    },
    "case_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Onboarding",
          "Periodic_Review",
          "Event_Driven_Review",
          "Offboarding"
        ]
      }
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "label",
    "item_type"
  ]
}