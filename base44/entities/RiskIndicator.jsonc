{
  "name": "RiskIndicator",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NP_Client",
          "ORG_Client",
          "NP_Related_Party",
          "ORG_Related_Party"
        ]
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "default_weight": {
      "type": "number",
      "default": 1.0,
      "description": "For post-MVP points scoring"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "name"
  ]
}