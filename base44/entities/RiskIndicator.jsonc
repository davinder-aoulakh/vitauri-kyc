{
  "name": "RiskIndicator",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NP_Client",
          "ORG_Client",
          "NP_Related_Party",
          "ORG_Related_Party"
        ]
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "Geography & Sector",
        "PEP & Sanctions",
        "Ownership & Structure",
        "Transaction & Financial Behaviour",
        "Relationship & Onboarding"
      ],
      "description": "Category group for the indicator picker UI"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "default_weight": {
      "type": "number",
      "default": 1.0,
      "description": "For post-MVP points scoring"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}