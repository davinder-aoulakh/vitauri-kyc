{
  "name": "AiAgentRun",
  "properties": {
    "abstained": {
      "default": false,
      "type": "boolean"
    },
    "agent_type": {
      "enum": [
        "OrgChart",
        "OutreachCopilot",
        "ClientOutreachCopilot",
        "ScreeningTriage",
        "ClientProfile",
        "SoFSoW",
        "IndicatorApplicability",
        "RiskNarrative",
        "WorkflowOptimisation",
        "StatementExtract",
        "KycTxnAnalysis",
        "ProfileProposal",
        "TmTriage",
        "TmEvidence",
        "TmNarrative",
        "TmRuleDraft"
      ],
      "type": "string"
    },
    "analyst_action": {
      "enum": [
        "Accepted",
        "Edited",
        "Overridden",
        "Rejected"
      ],
      "type": "string"
    },
    "analyst_justification": {
      "type": "string"
    },
    "case_id": {
      "description": "nullable",
      "type": "string"
    },
    "content_purged_at": {
      "format": "date-time",
      "type": "string"
    },
    "model_used": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "output_full": {
      "description": "Full model output (JSON), masked the same way",
      "type": "string"
    },
    "output_summary": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string"
    },
    "prompt_redacted": {
      "description": "Full prompt sent to the model, with contact details, account and ID numbers masked",
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "retain_until": {
      "description": "After this date purgeAiRunContent blanks prompt_redacted and output_full; the hash and summary stay",
      "format": "date",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tenant_id": {
      "type": "string"
    },
    "tm_alert_id": {
      "type": "string"
    },
    "tm_case_id": {
      "type": "string"
    },
    "tokens_input": {
      "type": "number"
    },
    "tokens_output": {
      "type": "number"
    }
  },
  "required": [
    "tenant_id",
    "agent_type"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}