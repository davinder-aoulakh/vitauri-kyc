{
  "name": "Document",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "description": "nullable"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "Passport",
        "ID_Card",
        "Selfie",
        "UBO_Register",
        "Articles_of_Association",
        "KYC_Report",
        "Outreach_Response",
        "Financial_Statement",
        "Tax_Return",
        "Salary_Slip",
        "Other"
      ]
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false
    },
    "related_party_id": {
      "type": "string",
      "description": "nullable \u2014 if doc belongs to a related party"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Pending_Review",
        "Approved",
        "Rejected"
      ],
      "default": "Pending_Review",
      "description": "Analyst approval status"
    },
    "review_notes": {
      "type": "string",
      "description": "Rejection reason or approval notes"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "e.g. didit, portal, manual"
    },
    "didit_session_id": {
      "type": "string",
      "description": "Didit session UUID \u2014 used for per-session deduplication"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "doc_type",
    "file_name",
    "file_url"
  ]
}