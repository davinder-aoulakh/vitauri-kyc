{
  "name": "Document",
  "properties": {
    "ai_check": {
      "description": "AI Document Checker result (advisory): { status: 'running'|'done'|'error', verdict: authentic|needs_attention|high_risk, score, summary, checks[], document_type_detected, matches_request, extracted, run_at, model, version, error }",
      "type": "object"
    },
    "case_id": {
      "description": "nullable",
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "deleted_at": {
      "format": "date-time",
      "type": "string"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "didit_session_id": {
      "description": "Didit session UUID \u2014 used for per-session deduplication",
      "type": "string"
    },
    "doc_type": {
      "enum": [
        "Passport",
        "ID_Card",
        "Selfie",
        "UBO_Register",
        "Articles_of_Association",
        "KYC_Report",
        "Outreach_Response",
        "Financial_Statement",
        "Tax_Return",
        "Salary_Slip",
        "Registry_Extract",
        "Other"
      ],
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_sha256": {
      "description": "SHA-256 of the file content \u2014 detects the same file uploaded for several clients",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "is_ai_generated": {
      "default": false,
      "type": "boolean"
    },
    "is_deleted": {
      "default": false,
      "type": "boolean"
    },
    "related_party_id": {
      "description": "nullable \u2014 if doc belongs to a related party",
      "type": "string"
    },
    "review_notes": {
      "description": "Rejection reason or approval notes",
      "type": "string"
    },
    "review_status": {
      "default": "Pending_Review",
      "description": "Analyst approval status",
      "enum": [
        "Pending_Review",
        "Approved",
        "Rejected"
      ],
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "source": {
      "description": "e.g. didit, portal, manual",
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number"
    }
  },
  "required": [
    "tenant_id",
    "client_id",
    "doc_type",
    "file_name",
    "file_url"
  ],
  "type": "object"
}