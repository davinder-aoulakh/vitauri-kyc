{
  "name": "CoverageDay",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "expected": {
      "type": "boolean",
      "default": true
    },
    "state": {
      "type": "string",
      "enum": [
        "missing",
        "awaiting",
        "received",
        "processed",
        "reviewed"
      ],
      "default": "missing"
    },
    "txn_count": {
      "type": "number",
      "default": 0
    },
    "source_type": {
      "type": "string"
    },
    "gap_reason": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "bank_account_id",
    "date"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}