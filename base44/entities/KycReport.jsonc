{
  "name": "KycReport",
  "properties": {
    "advice_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "created_reason": {
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_by_id": {
      "type": "string"
    },
    "hash": {
      "description": "SHA-256 of the PDF, set when the version is frozen",
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "report_data_snapshot": {
      "type": "object"
    },
    "status": {
      "description": "Final / Declined / Terminated versions are immutable; changes create a new version",
      "enum": [
        "Draft",
        "Draft incl. Compliance advice",
        "Final",
        "Declined",
        "Terminated",
        "Superseded"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    }
  },
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  },
  "required": []
}