{
  "name": "OutreachFormTemplate",
  "properties": {
    "applicable_case_types": {
      "items": {
        "enum": [
          "Onboarding",
          "Periodic_Review",
          "Event_Driven_Review",
          "Offboarding"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "applicable_client_types": {
      "items": {
        "enum": [
          "NP",
          "ORG"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "default_channel": {
      "default": "Email",
      "enum": [
        "Email",
        "Portal"
      ],
      "type": "string"
    },
    "default_deadline_days": {
      "default": 14,
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "email_template_id": {
      "description": "FK \u2192 EmailTemplate",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "items": {
      "description": "Ordered list of OutreachTemplate item references",
      "items": {
        "properties": {
          "idv_workflow_id": {
            "description": "Didit workflow for this verification field in this form; empty = the one set on the library field",
            "type": "string"
          },
          "idv_workflow_name": {
            "type": "string"
          },
          "is_mandatory": {
            "default": false,
            "type": "boolean"
          },
          "outreach_template_id": {
            "description": "FK \u2192 OutreachTemplate",
            "type": "string"
          },
          "sort_order": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "description": "Template display name",
      "type": "string"
    },
    "tenant_id": {
      "description": "FK \u2192 Tenant",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Compliance Admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}