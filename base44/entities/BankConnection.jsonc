{
  "name": "BankConnection",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "partner": {
      "type": "string"
    },
    "consent_id": {
      "type": "string"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expiring",
        "withdrawn",
        "expired"
      ],
      "default": "pending"
    },
    "consent_granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reauth_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "bank_account_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}