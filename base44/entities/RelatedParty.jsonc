{
  "name": "RelatedParty",
  "properties": {
    "country_of_residence": {
      "description": "NP only",
      "type": "string"
    },
    "date_of_birth": {
      "description": "NP only",
      "format": "date",
      "type": "string"
    },
    "didit_applied_fields": {
      "description": "Fields whose value an analyst accepted from Didit (ID&V or KYB registry)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "didit_idv_snapshot": {
      "description": "Data extracted by the person's own Didit ID verification, kept for review. Not applied until an analyst accepts it.",
      "properties": {
        "address": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string"
        },
        "first_name": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "id_expiry_date": {
          "type": "string"
        },
        "id_number": {
          "type": "string"
        },
        "id_type": {
          "type": "string"
        },
        "idv_status": {
          "type": "string"
        },
        "issuing_country": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "nationality": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "didit_reviewed_fields": {
      "description": "Fields where the analyst kept the recorded value over Didit's",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "full_name": {
      "type": "string"
    },
    "id_expiry_date": {
      "description": "NP only",
      "format": "date",
      "type": "string"
    },
    "id_number": {
      "description": "NP only",
      "type": "string"
    },
    "id_type": {
      "description": "NP only",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "legal_form": {
      "description": "ORG only",
      "type": "string"
    },
    "nationality": {
      "description": "NP only",
      "type": "string"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "party_type": {
      "enum": [
        "NP",
        "ORG"
      ],
      "type": "string"
    },
    "registered_address": {
      "description": "ORG only",
      "type": "string"
    },
    "registered_country": {
      "description": "ORG only",
      "type": "string"
    },
    "registration_number": {
      "description": "ORG only",
      "type": "string"
    },
    "residential_address": {
      "description": "NP only \u2014 address as on the identity document",
      "type": "string"
    },
    "risk_classification": {
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ],
      "type": "string"
    },
    "role_in_relationship": {
      "description": "UBO, Director, Shareholder, Beneficiary, Insured",
      "type": "string"
    },
    "sector": {
      "description": "ORG only",
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "verification_notes": {
      "type": "string"
    },
    "verification_status": {
      "default": "Unverified",
      "enum": [
        "Unverified",
        "Pending_Verification",
        "Verified",
        "Rejected"
      ],
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verified_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "party_type",
    "full_name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "Tenant Admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    }
  }
}