{
  "name": "RelatedParty",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "party_type": {
      "type": "string",
      "enum": [
        "NP",
        "ORG"
      ]
    },
    "full_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "NP only"
    },
    "nationality": {
      "type": "string",
      "description": "NP only"
    },
    "country_of_residence": {
      "type": "string",
      "description": "NP only"
    },
    "id_type": {
      "type": "string",
      "description": "NP only"
    },
    "id_number": {
      "type": "string",
      "description": "NP only"
    },
    "id_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "NP only"
    },
    "registration_number": {
      "type": "string",
      "description": "ORG only"
    },
    "registered_country": {
      "type": "string",
      "description": "ORG only"
    },
    "registered_address": {
      "type": "string",
      "description": "ORG only"
    },
    "sector": {
      "type": "string",
      "description": "ORG only"
    },
    "legal_form": {
      "type": "string",
      "description": "ORG only"
    },
    "role_in_relationship": {
      "type": "string",
      "description": "UBO, Director, Shareholder, Beneficiary, Insured"
    },
    "ownership_percentage": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "risk_classification": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unacceptable"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Unverified",
        "Pending_Verification",
        "Verified",
        "Rejected"
      ],
      "default": "Unverified"
    },
    "verification_notes": {
      "type": "string"
    },
    "verified_by_user_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "party_type",
    "full_name"
  ]
}