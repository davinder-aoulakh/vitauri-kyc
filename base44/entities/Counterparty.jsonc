{
  "name": "Counterparty",
  "properties": {
    "client_id": {
      "description": "Linked Vitauri customer (Client) when this counterparty is itself a customer of the tenant",
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "entity_kind": {
      "default": "unknown",
      "enum": [
        "person",
        "company",
        "unknown"
      ],
      "type": "string"
    },
    "identifiers": {
      "items": {
        "properties": {
          "type": {
            "enum": [
              "iban",
              "account",
              "wallet",
              "registration",
              "other"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "last_screened_at": {
      "format": "date-time",
      "type": "string"
    },
    "link_history": {
      "description": "Audit of link/unlink actions: { action, related_party_id, client_id, by_user_id, by_name, at, reason }",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "merge_history": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "merged_into": {
      "type": "string"
    },
    "names": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "items": {
        "properties": {
          "at": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "related_party_id": {
      "description": "Linked RelatedParty (UBO, director, related company) when this counterparty is one of the customer's own related parties",
      "type": "string"
    },
    "screening_hit_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "screening_status": {
      "default": "not_screened",
      "enum": [
        "not_screened",
        "clear",
        "potential_match",
        "confirmed_match"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "display_name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "Vitauri Ops"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Tenant Admin"
          }
        }
      ]
    }
  }
}