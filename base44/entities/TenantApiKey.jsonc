{
  "name": "TenantApiKey",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "key_prefix": {
      "type": "string",
      "description": "First 8 chars of the key, shown in UI"
    },
    "key_hash": {
      "type": "string",
      "description": "SHA-256 hex of the key"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "ingest:write"
      ]
    },
    "created_by_user_id": {
      "type": "string"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "label",
    "key_prefix",
    "key_hash"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}